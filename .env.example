# -----------------------------------------------------------------------------
# Axiz SQL Agent PoC - runtime configuration
# Do not use this template directly with Docker while required values are blank.
# Create or repair .env with: python scripts/generate_local_env.py
# Validate it with: python scripts/validate_env.py
# -----------------------------------------------------------------------------

# Project / container runtime
COMPOSE_PROJECT_NAME=axiz-pe-sql-agent-poc
APP_NAME=Axiz SQL Agent PoC
APP_ENV=local
APP_TIMEZONE=America/Lima
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
API_HOST=0.0.0.0
API_PORT=8000
API_HOST_PORT=8000
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
STREAMLIT_HOST_PORT=8501
TEAMS_HOST=0.0.0.0
TEAMS_PORT=3978
TEAMS_HOST_PORT=3978
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Required application secrets. Leave blank only in this template.
APP_SECRET_KEY=
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ROLES=["admin","analyst"]
BOOTSTRAP_SYNC_CREDENTIALS=true
INTERNAL_SERVICE_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:8501"]

# PostgreSQL infrastructure and idempotent bootstrap
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=
CONTROL_DATABASE=axiz_agent_control
BUSINESS_DATABASE=axiz_business_data
AGENT_READER_USER=agent_reader
AGENT_READER_PASSWORD=
AGENT_STATEMENT_TIMEOUT=20s
BOOTSTRAP_SCHEMA_VERSION=0.4.4
POSTGRES_BOOTSTRAP_RETRY_SECONDS=2
REFRESH_BUSINESS_DATA_ON_START=false
BUSINESS_DATA_MODE=embedded
BUSINESS_TIMEZONE=America/Lima

# Runtime connection strings. They stay blank in the template to avoid publishing
# reusable credentials. The generator fills or repairs them from the variables above.
DATABASE_URL=
CHECKPOINT_DATABASE_URL=
AGENT_DATABASE_URL=
AGENT_DATABASE_CONNECT_TIMEOUT_SECONDS=10
QUERY_ENGINE=postgres
QUERY_ENGINE_RETRY_ATTEMPTS=2
QUERY_ENGINE_RETRY_BASE_SECONDS=0.25

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_URL=redis://redis:6379/0

# Internal service URLs
API_BASE_URL=http://api:8000
STREAMLIT_API_BASE_URL=http://api:8000
API_HEALTH_PATH=/health/live

# Streamlit UI and HTTP behavior
STREAMLIT_TIMEZONE=America/Lima
STREAMLIT_PAGE_TITLE=Axiz | SQL Agent
STREAMLIT_PAGE_LAYOUT=wide
STREAMLIT_INITIAL_SIDEBAR_STATE=expanded
STREAMLIT_LOGIN_USERNAME=admin
STREAMLIT_DEFAULT_SESSION_TITLE=Nueva conversación
STREAMLIT_CHAT_INPUT_PLACEHOLDER=Pregunta o solicita cualquier cambio sobre la consulta
STREAMLIT_AUTO_SCROLL_ENABLED=true
STREAMLIT_AUTO_SCROLL_BEHAVIOR=auto
STREAMLIT_AUTO_SCROLL_DEBOUNCE_MS=40
STREAMLIT_AUTO_SCROLL_SETTLE_DELAYS_MS=[0,75,180,400,800]
STREAMLIT_RUN_RECOVERY_TIMEOUT_SECONDS=240
STREAMLIT_RUN_RECOVERY_POLL_INTERVAL_SECONDS=0.75
STREAMLIT_HTTP_TIMEOUT_SECONDS=30
STREAMLIT_AGENT_HTTP_TIMEOUT_SECONDS=180
STREAMLIT_EXPORT_HTTP_TIMEOUT_SECONDS=60
STREAMLIT_SSE_CONNECT_TIMEOUT_SECONDS=30
STREAMLIT_SSE_WRITE_TIMEOUT_SECONDS=30
STREAMLIT_SSE_POOL_TIMEOUT_SECONDS=30

# LLM providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=
LLM_PROVIDER=openai
AGENT_MODELS_CONFIG_PATH=/app/config/agents.yaml
SPECIALIST_REGISTRY_PATH=/app/config/specialists.yaml
AGENT_SKILLS_CONFIG_PATH=/app/config/agent_skills.yaml
SEMANTIC_CATALOG_PATH=/app/semantic_catalog

# Four reasoning roles in the governed autonomous society
AXIZ_DEFAULT_MODEL_PRESET=openai_gpt_5_6_terra_balanced
AXIZ_INVESTIGATION_COORDINATOR_MODEL_PRESET=openai_gpt_5_6_terra_balanced
AXIZ_DOMAIN_ANALYST_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_SQL_ENGINEER_MODEL_PRESET=openai_gpt_5_6_terra_sql
AXIZ_EVIDENCE_REVIEWER_MODEL_PRESET=openai_gpt_5_6_luna_explanation

# Active model catalog validation
MODEL_VALIDATION_ON_STARTUP=true
MODEL_VALIDATION_MODE=probe
MODEL_VALIDATION_FAILURE_POLICY=warn
MODEL_VALIDATION_TIMEOUT_SECONDS=20
MODEL_VALIDATION_CACHE_TTL_SECONDS=300

# Run idempotency, distributed leases and concurrency
RUN_LEASE_SECONDS=360
RUN_LEASE_HEARTBEAT_SECONDS=30
MAX_CONCURRENT_RUNS_PER_USER=2
MAX_CONCURRENT_LLM_CALLS=8

# Governed autonomous society
AUTONOMOUS_SOCIETY_ENABLED=true
AUTONOMOUS_MAX_ITERATIONS=4
AUTONOMOUS_MAX_TASKS=8
AUTONOMOUS_MAX_PARALLEL_TASKS=3
AUTONOMOUS_MAX_QUERIES=4
AUTONOMOUS_MAX_LLM_TOKENS=120000
AUTONOMOUS_MAX_ACTIVE_EXECUTION_SECONDS=600
AUTONOMOUS_MAX_TOTAL_PLAN_COST=500000
AUTONOMOUS_MAX_TOTAL_PLAN_ROWS=1000000
AUTONOMOUS_MAX_TOTAL_RELATION_BYTES=2147483648
AUTONOMOUS_MAX_TOTAL_DATABASE_SECONDS=90
AUTONOMOUS_ADAPTIVE_ROUTING_ENABLED=true
AUTONOMOUS_CONDITIONAL_REVIEW_ENABLED=true
AUTONOMOUS_REVIEW_HIGH_COST_RATIO=0.70
AUTONOMOUS_REVIEW_HIGH_ROW_RATIO=0.70
SEMANTIC_CONTEXT_MAX_DOCUMENTS=4
SEMANTIC_CONTEXT_MAX_EXAMPLES=1
SEMANTIC_CONTEXT_MAX_METRICS=0
SEMANTIC_CONTEXT_MAX_DIMENSIONS=0
SEMANTIC_CONTEXT_MAX_DOCUMENT_ITEMS=8
SEMANTIC_CONTEXT_MAX_SOURCE_CONTRACTS=0
SPECIALIST_HISTORY_MAX_MESSAGES=2
SPECIALIST_HISTORY_MAX_CHARS=1600
SPECIALIST_PRIOR_EVIDENCE_MAX_ITEMS=3
SPECIALIST_PRIOR_EVIDENCE_MAX_ROWS=2
AGENT_CACHE_ENABLED=true
AGENT_CACHE_NAMESPACE=axiz:agent-cache:v19
AGENT_CACHE_DEFAULT_TTL_SECONDS=900

# Semantic catalog and SQL policies
SQL_DIALECT=postgres
MAX_RESULT_ROWS=500
MAX_FEEDBACK_REPAIR_ATTEMPTS=2
MAX_PLAN_ROWS=250000
MAX_PLAN_COST=150000
MAX_RELATION_BYTES=536870912
SQL_TIMEOUT_SECONDS=20
MAX_SQL_REPAIR_ATTEMPTS=2
CONVERSATION_MEMORY_RESULT_SAMPLE_ROWS=5

# Excel export
EXCEL_EXPORT_ENABLED=true
EXCEL_EXPORT_MAX_ROWS=5000
EXCEL_EXPORT_ALLOW_TRUNCATED=false

# Structured observability
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_HTTP_REQUESTS=true
LOG_HEALTH_CHECKS=false
LOG_WORKFLOW_STAGES=true
LOG_LLM_CALLS=true
LOG_QUERY_EVENTS=true
LOG_SQL_TEXT=false
SSE_HEARTBEAT_SECONDS=15

# Container health checks and restart policies
POSTGRES_HEALTH_INTERVAL=5s
POSTGRES_HEALTH_TIMEOUT=5s
POSTGRES_HEALTH_RETRIES=60
POSTGRES_HEALTH_START_PERIOD=10s
REDIS_HEALTH_INTERVAL=5s
REDIS_HEALTH_TIMEOUT=3s
REDIS_HEALTH_RETRIES=20
API_HEALTH_INTERVAL=10s
API_HEALTH_TIMEOUT=5s
API_HEALTH_RETRIES=20
API_RESTART_POLICY=on-failure:5
TEAMS_RESTART_POLICY=unless-stopped

# Microsoft Teams adapter (optional profile: teams)
TEAMS_ENABLED=false
TEAMS_APP_TITLE=Axiz SQL Agent - Teams Adapter
TEAMS_HTTP_TIMEOUT_SECONDS=120
TEAMS_BOT_ID=
TEAMS_BOT_PASSWORD=
TEAMS_TENANT_ID=
TEAMS_OAUTH_CONNECTION_NAME=
TEAMS_CONNECTION_NAME=service_connection
TEAMS_AUTHENTICATION_TYPE=ClientSecret
TEAMS_BOT_SCOPE=https://api.botframework.com/.default
TEAMS_TOKEN_VALIDATION_ENABLED=true
# Live agentic evaluation harness
EVAL_API_BASE_URL=http://localhost:8000
EVAL_USERNAME=admin
EVAL_PASSWORD=
EVAL_HTTP_TIMEOUT_SECONDS=180
EVAL_MAX_POLLS=60
EVAL_POLL_INTERVAL_SECONDS=1
