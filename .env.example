# LLM providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Required only for direct Ollama Cloud API access; local Ollama ignores it.
OLLAMA_API_KEY=
LLM_PROVIDER=openai
AGENT_MODELS_CONFIG_PATH=/app/config/agents.yaml

# Select a complete provider/model preset per agent. Presets are declared in
# config/agents.yaml and include context, output, sampling, timeout and retries.
AXIZ_DEFAULT_MODEL_PRESET=openai_gpt_5_6_terra_balanced
AXIZ_INTENT_DOMAIN_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_SQL_GENERATOR_MODEL_PRESET=openai_gpt_5_6_terra_sql
AXIZ_RESULT_VERIFIER_MODEL_PRESET=openai_gpt_4_1_deterministic
AXIZ_EXPLANATION_MODEL_PRESET=openai_gpt_5_6_luna_explanation
AXIZ_CATALOG_ANSWER_MODEL_PRESET=openai_gpt_4_1_deterministic

# Example all-local routing (uses Ollama installed on the Docker host):
# AXIZ_INTENT_DOMAIN_MODEL_PRESET=ollama_qwen3_8b_structured
# AXIZ_SQL_GENERATOR_MODEL_PRESET=ollama_qwen3_coder_30b_sql
# AXIZ_RESULT_VERIFIER_MODEL_PRESET=ollama_gpt_oss_20b_reasoning
# AXIZ_EXPLANATION_MODEL_PRESET=ollama_qwen3_8b_structured
# AXIZ_CATALOG_ANSWER_MODEL_PRESET=ollama_qwen3_8b_structured

# FastAPI / authentication
APP_ENV=local
APP_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=Admin123!ChangeMe
INTERNAL_SERVICE_KEY=replace-internal-service-key

# PostgreSQL control-plane and read-only data-plane connections
# Control plane: users, sessions, messages, audit and LangGraph checkpoints.
DATABASE_URL=postgresql+psycopg://app_owner:app_owner@postgres:5432/axiz_agent_control
CHECKPOINT_DATABASE_URL=postgresql://app_owner:app_owner@postgres:5432/axiz_agent_control
# Data plane: operational/analytics/semantic data; the agent role can only SELECT semantic views.
# Embedded PoC database:
AGENT_DATABASE_URL=postgresql://agent_reader:agent_readonly@postgres:5432/axiz_business_data
# PostgreSQL installed on the Docker host:
# AGENT_DATABASE_URL=postgresql://agent_reader:password@host.docker.internal:5432/business_data
# External managed PostgreSQL with TLS:
# AGENT_DATABASE_URL=postgresql://agent_reader:password@db.example.com:5432/business_data?sslmode=verify-full&sslrootcert=/app/certs/root-ca.pem
AGENT_DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Redis
REDIS_URL=redis://redis:6379/0

# Semantic catalog and SQL policies
SEMANTIC_CATALOG_PATH=/app/semantic_catalog
SQL_DIALECT=postgres
MAX_RESULT_ROWS=500
MAX_PLAN_ROWS=250000
MAX_PLAN_COST=150000
MAX_RELATION_BYTES=536870912
SQL_TIMEOUT_SECONDS=20
MAX_SQL_REPAIR_ATTEMPTS=2

# Service URLs
API_BASE_URL=http://api:8000
STREAMLIT_API_BASE_URL=http://api:8000

# Microsoft Teams adapter (optional docker compose profile: teams)
TEAMS_ENABLED=false
TEAMS_PORT=3978
TEAMS_BOT_ID=
TEAMS_BOT_PASSWORD=
TEAMS_TENANT_ID=
TEAMS_OAUTH_CONNECTION_NAME=
