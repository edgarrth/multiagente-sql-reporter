# LLM providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Required only for direct Ollama Cloud API access; local Ollama ignores it.
OLLAMA_API_KEY=
LLM_PROVIDER=openai
AGENT_MODELS_CONFIG_PATH=/app/config/agents.yaml

# Select a complete provider/model preset per agent. Presets are declared in
# config/agents.yaml and include context, output, sampling, timeout and retries.
AXIZ_DEFAULT_MODEL_PRESET=openai_gpt_5_6_terra_balanced
AXIZ_CONTEXT_RESOLVER_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_INTENT_DOMAIN_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_CONVERSATION_CONTEXT_MODEL_PRESET=openai_gpt_5_6_luna_explanation
AXIZ_SQL_GENERATOR_MODEL_PRESET=openai_gpt_5_6_terra_sql
AXIZ_SQL_REPAIR_MODEL_PRESET=openai_gpt_5_6_terra_sql
AXIZ_SQL_REVISION_MODEL_PRESET=openai_gpt_5_6_terra_sql
AXIZ_FEEDBACK_INTERPRETER_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_FEEDBACK_COMPLIANCE_MODEL_PRESET=openai_gpt_4_1_deterministic
AXIZ_RESULT_VERIFIER_MODEL_PRESET=openai_gpt_4_1_deterministic
AXIZ_EXPLANATION_MODEL_PRESET=openai_gpt_5_6_luna_explanation
AXIZ_CATALOG_ANSWER_MODEL_PRESET=openai_gpt_4_1_deterministic

# Example all-Anthropic routing. Claude 5 presets omit temperature/top_p/top_k because
# current Claude 4.7+ and Claude 5 models reject those sampling parameters.
# LLM_PROVIDER=anthropic
# AXIZ_DEFAULT_MODEL_PRESET=anthropic_claude_sonnet_5_balanced
# AXIZ_CONTEXT_RESOLVER_MODEL_PRESET=anthropic_claude_haiku_4_5_routing
# AXIZ_INTENT_DOMAIN_MODEL_PRESET=anthropic_claude_haiku_4_5_routing
# AXIZ_CONVERSATION_CONTEXT_MODEL_PRESET=anthropic_claude_sonnet_5_explanation
# AXIZ_SQL_GENERATOR_MODEL_PRESET=anthropic_claude_sonnet_5_sql
# AXIZ_SQL_REPAIR_MODEL_PRESET=anthropic_claude_sonnet_5_sql
# AXIZ_SQL_REVISION_MODEL_PRESET=anthropic_claude_sonnet_5_sql
# AXIZ_FEEDBACK_INTERPRETER_MODEL_PRESET=anthropic_claude_haiku_4_5_routing
# AXIZ_FEEDBACK_COMPLIANCE_MODEL_PRESET=anthropic_claude_sonnet_5_balanced
# AXIZ_RESULT_VERIFIER_MODEL_PRESET=anthropic_claude_sonnet_5_balanced
# AXIZ_EXPLANATION_MODEL_PRESET=anthropic_claude_sonnet_5_explanation
# AXIZ_CATALOG_ANSWER_MODEL_PRESET=anthropic_claude_sonnet_5_balanced
# AXIZ_AUTONOMOUS_ROUTER_MODEL_PRESET=anthropic_claude_haiku_4_5_routing
# AXIZ_AUTONOMOUS_SUPERVISOR_MODEL_PRESET=anthropic_claude_sonnet_5_balanced
# AXIZ_INVESTIGATION_PLANNER_MODEL_PRESET=anthropic_claude_sonnet_5_balanced
# AXIZ_ACQUIRING_SPECIALIST_MODEL_PRESET=anthropic_claude_haiku_4_5_routing
# AXIZ_ISSUING_SPECIALIST_MODEL_PRESET=anthropic_claude_haiku_4_5_routing
# AXIZ_FRAUD_SPECIALIST_MODEL_PRESET=anthropic_claude_sonnet_5_balanced
# AXIZ_CHARGEBACKS_SPECIALIST_MODEL_PRESET=anthropic_claude_haiku_4_5_routing
# AXIZ_TEMPORAL_SPECIALIST_MODEL_PRESET=anthropic_claude_haiku_4_5_routing
# AXIZ_CRITIC_MODEL_PRESET=anthropic_claude_sonnet_5_balanced
# AXIZ_AUTONOMOUS_SYNTHESIS_MODEL_PRESET=anthropic_claude_sonnet_5_explanation

# Example all-local routing (uses Ollama installed on the Docker host):
# AXIZ_CONTEXT_RESOLVER_MODEL_PRESET=ollama_qwen3_8b_structured
# AXIZ_INTENT_DOMAIN_MODEL_PRESET=ollama_qwen3_8b_structured
# AXIZ_CONVERSATION_CONTEXT_MODEL_PRESET=ollama_qwen3_8b_structured
# AXIZ_SQL_GENERATOR_MODEL_PRESET=ollama_qwen3_coder_30b_sql
# AXIZ_SQL_REPAIR_MODEL_PRESET=ollama_qwen3_coder_30b_sql
# AXIZ_SQL_REVISION_MODEL_PRESET=ollama_qwen3_coder_30b_sql
# AXIZ_FEEDBACK_INTERPRETER_MODEL_PRESET=ollama_qwen3_8b_structured
# AXIZ_FEEDBACK_COMPLIANCE_MODEL_PRESET=ollama_qwen3_8b_structured
# AXIZ_RESULT_VERIFIER_MODEL_PRESET=ollama_gpt_oss_20b_reasoning
# AXIZ_EXPLANATION_MODEL_PRESET=ollama_qwen3_8b_structured
# AXIZ_CATALOG_ANSWER_MODEL_PRESET=ollama_qwen3_8b_structured


# Active model catalog validation. `probe` checks provider catalog availability and
# performs one minimal Structured Outputs call per unique configured model.
MODEL_VALIDATION_ON_STARTUP=true
MODEL_VALIDATION_MODE=probe
MODEL_VALIDATION_FAILURE_POLICY=warn
MODEL_VALIDATION_TIMEOUT_SECONDS=20
MODEL_VALIDATION_CACHE_TTL_SECONDS=300

# FastAPI / authentication
APP_ENV=local
APP_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=Admin123!ChangeMe
INTERNAL_SERVICE_KEY=replace-internal-service-key

# Credentials used by the embedded PostgreSQL service and its idempotent bootstrap.
POSTGRES_PASSWORD=app_owner
AGENT_READER_PASSWORD=agent_readonly
# Set true only when the synthetic analytics/semantic layer must be rebuilt on startup.
REFRESH_BUSINESS_DATA_ON_START=false

# PostgreSQL control-plane and read-only data-plane connections
# Control plane: users, sessions, messages, audit and LangGraph checkpoints.
DATABASE_URL=postgresql+psycopg://app_owner:app_owner@postgres:5432/axiz_agent_control
CHECKPOINT_DATABASE_URL=postgresql://app_owner:app_owner@postgres:5432/axiz_agent_control
# Data plane engine. PostgreSQL is included; add new engines through QueryEngineFactory.
QUERY_ENGINE=postgres
QUERY_ENGINE_RETRY_ATTEMPTS=2
QUERY_ENGINE_RETRY_BASE_SECONDS=0.25

# Data plane: operational/analytics/semantic data; the agent role can only SELECT semantic views.
# Default for the PoC: data is generated inside the PostgreSQL service declared in Docker Compose.
BUSINESS_DATA_MODE=embedded
AGENT_DATABASE_URL=postgresql://agent_reader:agent_readonly@postgres:5432/axiz_business_data

# Production option: keep the control plane in its own database and point the data plane
# to an external governed PostgreSQL instance. No application-code change is required.
# BUSINESS_DATA_MODE=external
# AGENT_DATABASE_URL=postgresql://agent_reader:password@db.example.com:5432/business_data?sslmode=verify-full&sslrootcert=/app/certs/root-ca.pem
# PostgreSQL installed on the Docker host can also be used for local integration tests:
# AGENT_DATABASE_URL=postgresql://agent_reader:password@host.docker.internal:5432/business_data
AGENT_DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Run idempotency, distributed leases and process-level LLM concurrency.
RUN_LEASE_SECONDS=360
RUN_LEASE_HEARTBEAT_SECONDS=30
MAX_CONCURRENT_RUNS_PER_USER=2
MAX_CONCURRENT_LLM_CALLS=8

# Redis
REDIS_URL=redis://redis:6379/0

# Semantic catalog and SQL policies
SEMANTIC_CATALOG_PATH=/app/semantic_catalog
SQL_DIALECT=postgres
MAX_RESULT_ROWS=500
MAX_FEEDBACK_REPAIR_ATTEMPTS=2
MAX_PLAN_ROWS=250000
MAX_PLAN_COST=150000
MAX_RELATION_BYTES=536870912
SQL_TIMEOUT_SECONDS=20
MAX_SQL_REPAIR_ATTEMPTS=2
CONVERSATION_MEMORY_RESULT_SAMPLE_ROWS=5

# Excel export policy. Exports are generated only from completed, non-empty tabular results.
EXCEL_EXPORT_ENABLED=true
EXCEL_EXPORT_MAX_ROWS=5000
EXCEL_EXPORT_ALLOW_TRUNCATED=false

# Service URLs
API_BASE_URL=http://api:8000
STREAMLIT_API_BASE_URL=http://api:8000

# Microsoft Teams adapter (optional docker compose profile: teams)
TEAMS_ENABLED=false
TEAMS_PORT=3978
TEAMS_BOT_ID=
TEAMS_BOT_PASSWORD=
TEAMS_TENANT_ID=
TEAMS_OAUTH_CONNECTION_NAME=


# Governed autonomous society
AUTONOMOUS_SOCIETY_ENABLED=true
AUTONOMOUS_MAX_ITERATIONS=4
AUTONOMOUS_MAX_TASKS=8
AUTONOMOUS_MAX_PARALLEL_TASKS=3
AUTONOMOUS_MAX_QUERIES=4
AUTONOMOUS_MAX_LLM_TOKENS=120000
AUTONOMOUS_MAX_ACTIVE_EXECUTION_SECONDS=600
AUTONOMOUS_MAX_TOTAL_PLAN_COST=500000
AUTONOMOUS_MAX_TOTAL_PLAN_ROWS=1000000
AUTONOMOUS_MAX_TOTAL_RELATION_BYTES=2147483648
AUTONOMOUS_MAX_TOTAL_DATABASE_SECONDS=90
AUTONOMOUS_ADAPTIVE_ROUTING_ENABLED=true
AUTONOMOUS_CONDITIONAL_REVIEW_ENABLED=true
AUTONOMOUS_REVIEW_HIGH_COST_RATIO=0.70
AUTONOMOUS_REVIEW_HIGH_ROW_RATIO=0.70
SEMANTIC_CONTEXT_MAX_DOCUMENTS=4
SEMANTIC_CONTEXT_MAX_EXAMPLES=1
SEMANTIC_CONTEXT_MAX_METRICS=10
SEMANTIC_CONTEXT_MAX_DIMENSIONS=12
SEMANTIC_CONTEXT_MAX_DOCUMENT_ITEMS=8
SEMANTIC_CONTEXT_MAX_SOURCE_CONTRACTS=3
SPECIALIST_HISTORY_MAX_MESSAGES=2
SPECIALIST_HISTORY_MAX_CHARS=1600
SPECIALIST_PRIOR_EVIDENCE_MAX_ITEMS=3
SPECIALIST_PRIOR_EVIDENCE_MAX_ROWS=2
AGENT_CACHE_ENABLED=true
AGENT_CACHE_NAMESPACE=axiz:agent-cache:v10
AGENT_CACHE_DEFAULT_TTL_SECONDS=900
SPECIALIST_REGISTRY_PATH=config/specialists.yaml

AXIZ_AUTONOMOUS_ROUTER_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_AUTONOMOUS_SUPERVISOR_MODEL_PRESET=openai_gpt_5_6_terra_balanced
AXIZ_INVESTIGATION_PLANNER_MODEL_PRESET=openai_gpt_5_6_terra_balanced
AXIZ_ACQUIRING_SPECIALIST_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_ISSUING_SPECIALIST_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_FRAUD_SPECIALIST_MODEL_PRESET=openai_gpt_5_6_terra_balanced
AXIZ_CHARGEBACKS_SPECIALIST_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_TEMPORAL_SPECIALIST_MODEL_PRESET=openai_gpt_5_6_luna_routing
AXIZ_CRITIC_MODEL_PRESET=openai_gpt_4_1_deterministic
AXIZ_AUTONOMOUS_SYNTHESIS_MODEL_PRESET=openai_gpt_5_6_luna_explanation
# Observabilidad y diagnóstico
# JSON es la opción recomendada para Docker/Loki/ELK. Use console solo en desarrollo local.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_HTTP_REQUESTS=true
# Mantiene activos los health checks, pero no escribe sus accesos en los logs.
LOG_HEALTH_CHECKS=false
LOG_WORKFLOW_STAGES=true
LOG_LLM_CALLS=true
LOG_QUERY_EVENTS=true
# No habilitar en producción salvo diagnóstico controlado: puede contener datos de negocio.
LOG_SQL_TEXT=false
# Evita que proxies cierren streams SSE durante llamadas LLM largas.
SSE_HEARTBEAT_SECONDS=15
# Tiempo máximo de reconciliación si un stream SSE se cierra antes del evento final.
STREAMLIT_RUN_RECOVERY_TIMEOUT_SECONDS=240
